[Unit]
Description=SICAV - backup diario (banco + fotos)
Documentation=file:/opt/sistema-visitantes/README.md
RequiresMountsFor=/mnt/sstv-sicav
AssertPathIsMountPoint=/mnt/sstv-sicav
After=visitantes.service

[Service]
Type=oneshot
WorkingDirectory=/opt/sistema-visitantes
ExecStart=/opt/sistema-visitantes/scripts/backup.sh
TimeoutStartSec=3600
