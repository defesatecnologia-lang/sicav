[Unit]
Description=SICAV - Sistema de Gerenciamento e Controle de Visitantes
Documentation=file:/opt/sistema-visitantes/README.md
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
# Os drives de dados TEM que estar montados antes do Compose criar os bind
# mounts: banco no RAID6 (/mnt/sstv-sigav) e fotos em /mnt/sstv-dados.
RequiresMountsFor=/mnt/sstv-sigav /mnt/sstv-dados
AssertPathIsMountPoint=/mnt/sstv-sigav
AssertPathIsMountPoint=/mnt/sstv-dados

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/sistema-visitantes
ExecStart=/opt/sistema-visitantes/scripts/deploy.sh
ExecStop=/usr/bin/docker compose -f /opt/sistema-visitantes/docker-compose.yml down
TimeoutStartSec=900
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
