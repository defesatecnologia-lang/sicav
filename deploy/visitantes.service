[Unit]
Description=SICAV - Sistema de Gerenciamento e Controle de Visitantes
Documentation=file:/opt/sistema-visitantes/README.md
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
# O RAID6 TEM que estar montado antes do Compose criar os bind mounts:
# banco, fotos e backups ficam dentro de /mnt/sstv-sicav.
RequiresMountsFor=/mnt/sstv-sicav
AssertPathIsMountPoint=/mnt/sstv-sicav

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/sistema-visitantes
ExecStart=/opt/sistema-visitantes/scripts/deploy.sh
ExecStop=/usr/bin/docker compose -f /opt/sistema-visitantes/docker-compose.yml down
TimeoutStartSec=900
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
