# Docker environment - the entrypoint.sh uses this as fallback
# (VISITORPASS_DB_HOST is overridden by docker-compose environment)
VISITORPASS_DB_HOST=db
VISITORPASS_DB_NAME=visitorpass
VISITORPASS_DB_USER=vpuser
VISITORPASS_DB_PASS=visitorpassword
VISITORPASS_SESSION_TIMEOUT=3600
VISITORPASS_SESSION_ABSOLUTE_LIFETIME=43200
# Obrigatorio para MFA (64 hex chars = 32 bytes). Gere com: openssl rand -hex 32
VISITORPASS_MFA_KEY=
